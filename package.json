{
  "name": "admin-astro",
  "version": "1.0.1",
  "private": true,
  "description": "my web dev project ",
  "keywords": [
    "Astro",
    "Bun",
    "Shadcn",
    "UI",
    "Tailwindcss",
    "Drizzle",
    "ORM",
    "Admin",
    "Panel"
  ],
  "license": "MIT",
  "author": "hvidom",
  "type": "module",
  "scripts": {
    "dev": "bunx --bun astro dev",
    "browserslist": "bunx update-browserslist-db@latest",
    "build": "bun run astro check && bunx --bun astro build && bun run build:tailwind && bun run build:postcss",
    "sync": "astro sync",
    "build:tailwind": "bun x @tailwindcss/cli -i src/styles/global.css -o dist/global.css --minify",
    "build:postcss": "postcss dist/global.css -o dist/global.css",
    "preview": "astro build && astro preview",
    "astro": "astro",
    "db:push": "bun drizzle-kit push",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "studio": "bunx drizzle-kit studio --port 4984",
    "db:check": "bun drizzle-kit check"
  },
  "dependencies": {
    "@astrojs/node": "^10.1.1",
    "@astrojs/react": "^5.0.5",
    "@fontsource-variable/inter": "^5.2.8",
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "astro": "^6.3.3",
    "better-sqlite3": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.16.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@libsql/client": "^0.17.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "latest",
    "@types/node": "^25.7.0",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.5.14",
    "postcss-cli": "^11.0.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
