---
export const prerender = false;
import AdminDashboard from "@/components/react/AdminDashboard";
import Layout from "@/layouts/Layout.astro";
import "@/styles/global.css";

// Защита админки
const adminCookie = Astro.cookies.get("admin_session");
if (!adminCookie || adminCookie.value !== "is_logged_in") {
    return Astro.redirect("/admin/login");
}
---

<Layout title="Admin dashboard" description="My admin dashboard">
    <AdminDashboard client:load />
</Layout>

