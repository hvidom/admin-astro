---
export const prerender = false;
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import Layout from "@/layouts/Layout.astro";
// 1. Инициализируем переменную заранее
let errorMessage: string | null = null; 

const adminCookie = Astro.cookies.get("admin_session");
if (adminCookie?.value === "is_logged_in") {
    return Astro.redirect("/admin");
}

if (Astro.request.method === "POST") {
    const formData = await Astro.request.formData();
    const user = formData.get("username");
    const pass = formData.get("password");

    if (user === import.meta.env.ADMIN_USERNAME && pass === import.meta.env.ADMIN_PASSWORD) {
        Astro.cookies.set("admin_session", "is_logged_in", { 
            path: "/", 
            httpOnly: true,
            secure: true,
            sameSite: "lax"
        });
        return Astro.redirect("/admin");
    } else {
        // 2. Присваиваем значение при ошибке
        errorMessage = "Incorrect login or password";
    }
}
---
<Layout title="Admin Login Page" description="My admin login page with static .env">

    <div class="min-h-screen flex items-center justify-center">
        <div class="max-w-md w-full space-y-8">
            <div class="text-center">
                <h1 class="text-3xl font-black scroll-m-20 text-center text-indigo-600 tracking-tight text-balance">ADMIN ACCESS</h1>
            </div>
    
            <form method="POST" class="space-y-4">
                <!-- 3. Используем новую переменную с проверкой -->
                {errorMessage && (
                    <div class="bg-rose-500/10 border border-rose-500/20 text-rose-500 p-3 rounded-xl text-sm text-center">
                        {errorMessage}
                    </div>
                )}
                
                <Input name="username" type="text" placeholder="Username" required 
                    className="w-full p-4 rounded-2xl  border-slate-800 border focus:ring-2 ring-indigo-500 outline-none transition-all" />
                
                <Input name="password" type="password" placeholder="Password" required 
                    className="w-full p-4 rounded-2xl  border-slate-800 border focus:ring-2 ring-indigo-500 outline-none transition-all" />
                
                <Button type="submit" variant={"link"} className="w-full bg-indigo-600 hover:bg-indigo-500 text-white p-4 rounded-2xl font-black shadow-lg shadow-indigo-500/20 transition-all">
                    Sign in
                </Button>
            </form>
        </div>
    </div>
</Layout>