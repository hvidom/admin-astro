---
export const prerender = false;

// 1. ПРОВЕРКА АВТОРИЗАЦИИ
const adminCookie = Astro.cookies.get("admin_session");
if (!adminCookie || adminCookie.value !== "is_logged_in") {
    return Astro.redirect("/admin/login");
}

import { db } from "@/lib/db";
import ClientsTable from "@/components/react/ClientsTable";
import QuickActions from "@/components/react/QuickActions";
import "@/styles/global.css";

const allClients = await db.query.clients.findMany();
const allOrders = await db.query.orders.findMany({
  with: {
    client: true,
    item: true
  }
});
const allItems = await db.query.items.findMany();

const totalSales = allOrders.reduce((sum, order) => sum + (order.amount || 0), 0);
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <title>Panel CRM</title>
  </head>
  <body class="bg-slate-50 min-h-screen pb-20">
    <header class="border-b bg-white sticky top-0 z-10 shadow-sm">
      <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
        <div class="flex items-center gap-4">
            <span class="font-bold text-xl tracking-tight text-slate-900">Astro CRM</span>
            <div class="hidden sm:block text-[10px] font-mono text-slate-400 bg-slate-50 px-2 py-1 rounded border">v1.0.4 | SQLite</div>
        </div>

        <div class="flex items-center gap-4">
          <span class="hidden md:flex items-center gap-1.5 text-xs bg-emerald-50 text-emerald-700 font-medium px-3 py-1 rounded-full border border-emerald-100">
            <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-pulse"></span>
            Active Session
          </span>

          <!-- КНОПКА LOGOUT -->
          <button 
            id="logout-btn"
            class="flex items-center gap-2 px-4 py-2 rounded-lg bg-rose-50 text-rose-600 hover:bg-rose-100 font-bold text-xs transition-all border border-rose-100 shadow-sm active:scale-95"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
            Logout
          </button>
        </div>
      </div>
    </header>

    <main class="max-w-7xl mx-auto py-8 px-4 space-y-12">
      <!-- ТВОИ СЕКЦИИ: Статистика, QuickActions, Таблицы (оставляем как есть) -->
      
      <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white p-6 rounded-xl border shadow-sm">
          <p class="text-sm text-slate-500">Clients</p>
          <p class="text-3xl font-bold">{allClients.length}</p>
        </div>
        <div class="bg-white p-6 rounded-xl border shadow-sm">
          <p class="text-sm text-slate-500">Products in the catalog</p>
          <p class="text-3xl font-bold">{allItems.length}</p>
        </div>
        <div class="bg-white p-6 rounded-xl border shadow-sm border-emerald-100">
          <p class="text-sm text-emerald-600 font-medium">Revenue</p>
          <p class="text-3xl font-bold text-emerald-700">
            {totalSales.toLocaleString('en-US', { style: 'currency', currency: 'USD' })}
          </p>
        </div>
      </section>

      <QuickActions clients={allClients} items={allItems} client:load />

      <hr class="border-slate-200" />

      <section>
        <h2 class="text-2xl font-bold mb-4">👤 Customers</h2>
        <ClientsTable initialClients={allClients} client:load />
      </section>

      <!-- ... остальные таблицы (Items, Orders) ... -->
       <section>
        <h2 class="text-2xl font-bold mb-4">📦 Catalog of goods and services</h2>
        <div class="bg-white border rounded-xl overflow-hidden shadow-sm">
          <table class="w-full text-sm text-left">
            <thead class="bg-slate-50 border-b text-slate-500 uppercase text-xs">
              <tr>
                <th class="px-6 py-4 font-semibold">Name</th>
                <th class="px-6 py-4 font-semibold">Type</th>
                <th class="px-6 py-4 font-semibold">Price</th>
                <th class="px-6 py-4 font-semibold">Warehouse</th>
              </tr>
            </thead>
            <tbody class="divide-y">
              {allItems.map(item => (
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 font-medium">{item.name}</td>
                  <td class="px-6 py-4">
                    <span class={`px-2 py-1 rounded text-[10px] font-bold uppercase ${item.type === 'product' ? 'bg-blue-100 text-blue-700' : 'bg-purple-100 text-purple-700'}`}>
                      {item.type === 'product' ? 'Товар' : 'Услуга'}
                    </span>
                  </td>
                  <td class="px-6 py-4">${item.price}</td>
                  <td class="px-6 py-4 text-slate-500">{item.stock !== null ? `${item.stock} pcs.` : '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-bold mb-4">🛒 Last orders</h2>
        <div class="bg-white border rounded-xl overflow-hidden shadow-sm">
          <table class="w-full text-sm text-left">
            <thead class="bg-slate-50 border-b text-slate-500 uppercase text-xs">
              <tr>
                <th class="px-6 py-4 font-semibold">ID</th> 
                <th class="px-6 py-4 font-semibold">Client</th> 
                <th class="px-6 py-4 font-semibold">Product</th> 
                <th class="px-6 py-4 font-semibold">Amount</th> 
                <th class="px-6 py-4 font-semibold">Status</th> 
                <th class="px-6 py-4 font-semibold">Date</th>
              </tr>
            </thead>
            <tbody class="divide-y">
              {allOrders.map(order => (
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="px-6 py-4 text-slate-400 text-xs">#{order.id}</td>
                  <td class="px-6 py-4 font-medium">{(order as any).client?.name}</td>
                  <td class="px-6 py-4 text-slate-600">{(order as any).item?.name}</td>
                  <td class="px-6 py-4 font-bold text-slate-900">${order.amount}</td>
                  <td class="px-6 py-4">
                    <span class={`px-2 py-1 rounded-full text-[10px] font-bold ${order.status === 'completed' ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-700'}`}>
                      {order.status === 'completed' ? 'Paid' : 'Processing'}
                    </span>
                  </td>
                  <td class="px-6 py-4 text-slate-500 text-xs">{new Date(order.createdAt!).toLocaleDateString('en')}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    </main>

    <!-- СКРИПТ ЛОГАУТА -->
    <script>
      const logoutBtn = document.getElementById('logout-btn');
      
      logoutBtn?.addEventListener('click', async () => {
      // Add a simple confirmation to avoid accidentally logging out
      if (!confirm('Are you sure you want to log out?')) return;
      
      try {
      const response = await fetch('/api/admin-logout', {
      method: 'POST',
      });
      
      if (response.ok) {
      // Redirect to the login page
      window.location.href = '/admin/login';
      } else {
      alert('Error logging out');
      }
      } catch (error) {
      console.error('Logout error:', error);
      alert('A connection error occurred');
      }
      });
      </script>
  </body>
</html>