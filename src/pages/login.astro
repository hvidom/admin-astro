---
export const prerender = false;
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import Layout from "@/layouts/Layout.astro";
import "@/styles/global.css";
---
<Layout title="Login">
<div class="min-h-screen flex items-center justify-center  px-4">
    <div class="max-w-md w-full b p-8 rounded-3xl border shadow-sm">
        <h1 class="text-2xl text-center text-color-accent font-black mb-2">Welcome back!</h1>
        <p class="text-sm text-center mb-6">Log in to your account</p>
        
        <form id="login-form" class="space-y-4">
            <Input type="email" name="email" placeholder="Email" required className="w-full p-3 border rounded-xl outline-none focus:ring-2 ring-indigo-500/20 focus:border-indigo-500" />
            <Input type="password" name="password" placeholder="Пароль" required className="w-full p-3 border rounded-xl outline-none focus:ring-2 ring-indigo-500/20 focus:border-indigo-500" />
            <Button type="submit" id="submit-btn" className="w-full   p-3 rounded-xl font-bold  transition-all active:scale-[0.98]">
                Login
            </Button>
        </form>

        <div class="mt-6 space-y-4 text-center">
            <p class="text-sm ">
                Have no account yet? <a href="/signup" class="text-indigo-600 font-bold hover:underline">Create</a>
            </p>
            <hr class="" />
            <Button variant={"ghost"}>
            <a href="/admin/login" class="inline-block text-xs transition">
                Login as Admin
            </a>
        </Button>
        </div>
    </div>
</div>
</Layout>

<script>
    import { authClient } from "@/lib/auth-client";

    document.getElementById("login-form")?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const btn = document.getElementById("submit-btn") as HTMLButtonElement;
        const formData = new FormData(e.target as HTMLFormElement);

        btn.disabled = true;
        btn.innerText = "Entrance...";

        const { error } = await authClient.signIn.email({
            email: formData.get("email") as string,
            password: formData.get("password") as string,
            callbackURL: "/dashboard"
        });

        if (error) {
            alert(error.message);
            btn.disabled = false;
            btn.innerText = "login";
        } else {
            window.location.href = "/dashboard";
        }
    });
</script>