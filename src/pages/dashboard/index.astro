---
export const prerender = false;
import { auth } from "@/lib/auth";
import { db } from "@/lib/db";
import { clients, items, orders } from "@/db/schema";
import { eq, desc } from "drizzle-orm";
import Layout from "@/layouts/Layout.astro";

// UI Components Imports
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table";

const session = await auth.api.getSession({ 
  headers: Astro.request.headers,
});

if (!session) { 
  return Astro.redirect("/login");
}

const { user } = session;

// 1. Sync User metadata into the CRM Clients schema automatically
let clientRecord = await db.query.clients.findFirst({
  where: eq(clients.email, user.email)
});

if (!clientRecord) {
  const newClients = await db.insert(clients).values({
    name: user.name,
    email: user.email,
    status: "active",
  }).returning();
  clientRecord = newClients[0];
}

// 2. Fetch dependencies for client overview
const availableItems = await db.query.items.findMany();

const clientOrders = await db.query.orders.findMany({
  where: eq(orders.clientId, clientRecord!.id),
  orderBy: [desc(orders.createdAt)]
});

const totalSpent = clientOrders
  .filter(o => o.status === "completed")
  .reduce((sum, o) => sum + o.amount, 0);
---

<Layout title="Personal Account" description="Your personal dashboard">
  <div class="min-h-screen antialiased">
    <nav class="border-b sticky top-0 z-10 backdrop-blur-md"> 
      <div class="max-w-5xl mx-auto px-4 h-16 flex items-center justify-between"> 
        <span class="text-xl font-black tracking-tight">MY DASHBOARD</span> 

        <div class="flex items-center gap-4"> 
          <div class="text-right hidden sm:block"> 
            <p class="text-sm font-bold leading-none">{user.name}</p> 
            <p class="text-[10px] text-indigo-400 font-bold mt-1 bg-indigo-950/50 border border-indigo-900 px-2 py-0.5 rounded-full uppercase inline-block">CRM Client</p> 
          </div> 
          <Button id="logout-btn" variant="ghost" size="icon" className="text-rose-400 hover:bg-rose-950/30 hover:text-rose-500 rounded-xl"> 
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg> 
          </Button>
        </div>
      </div>
    </nav>

    <main class="max-w-5xl mx-auto py-10 px-4 space-y-8">
      <header>
        <h1 class="text-4xl font-black tracking-tight">Welcome, {user.name}!</h1>
        <p class="mt-2 text-muted-foreground">Here you can place new orders and track your service status.</p>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Profile Columns -->
        <div class="col-span-1 space-y-6">
          <Card className="rounded-3xl shadow-sm">
            <CardHeader className="pb-3">
              <CardDescription className="font-bold uppercase text-[10px] tracking-widest text-muted-foreground">Data Profile</CardDescription>
            </CardHeader>
            <CardContent className="space-y-1">
              <CardTitle className="font-bold text-lg">{user.name}</CardTitle>
              <p class="text-sm text-muted-foreground truncate">{user.email}</p>
              <p class="text-xs text-muted-foreground/60 pt-2 border-t mt-2">CRM System ID: #{clientRecord!.id}</p>
            </CardContent>
          </Card>

          <Card className="rounded-3xl shadow-sm">
            <CardHeader className="pb-2">
              <CardDescription className="font-bold uppercase text-[10px] tracking-widest text-muted-foreground">Total Paid</CardDescription>
            </CardHeader>
            <CardContent>
              <p class="text-3xl font-black text-indigo-400">${totalSpent}</p>
              <p class="text-xs text-muted-foreground mt-1">For all completed orders</p>
            </CardContent>
          </Card>
        </div>

        <!-- Interactive Content Segment -->
        <div class="md:col-span-2 space-y-6">
          <div class="bg-indigo-600 p-8 rounded-3xl shadow-xl shadow-indigo-950/20 text-white flex flex-col justify-between sm:flex-row sm:items-center gap-4">
            <div>
              <h3 class="text-indigo-200 font-bold uppercase text-[10px] tracking-widest mb-2">Quick Action</h3>
              <p class="text-xl font-bold">Need a new product or service?</p>
            </div>
            <Button id="open-order-modal" className="bg-white text-indigo-600 px-6 py-6 rounded-2xl font-bold text-sm hover:bg-indigo-50 transition-all shadow-md active:scale-95 whitespace-nowrap border-0"> 
              Create New Order 
            </Button> 
          </div>

          <!-- History Logs Grid -->
          <Card className="rounded-3xl shadow-sm overflow-hidden">
            <CardHeader className="border-b">
              <CardTitle className="text-lg font-bold">Your Orders History</CardTitle>
            </CardHeader>
            <CardContent className="p-0">
              {clientOrders.length === 0 ? (
                <div class="p-8 text-center text-muted-foreground text-sm">
                  You haven't placed any orders yet.
                </div>
              ) : (
                <Table>
                  <TableHeader>
                    <TableRow className="hover:bg-transparent">
                      <TableHead className="font-semibold text-xs uppercase h-11 pl-6">Order ID</TableHead>
                      <TableHead className="font-semibold text-xs uppercase h-11">Amount</TableHead>
                      <TableHead className="font-semibold text-xs uppercase h-11 pr-6">Status</TableHead>
                    </TableRow>
                  </TableHeader>
                  <TableBody className="text-sm">
                    {clientOrders.map(order => (
                      <TableRow className="transition-colors">
                        <TableCell className="font-mono text-xs text-muted-foreground/60 pl-6">#{order.id}</TableCell>
                        <TableCell className="font-bold">${order.amount}</TableCell>
                        <TableCell className="pr-6">
                          <span class={`text-[10px] px-2 py-0.5 rounded-full font-black uppercase inline-block ${order.status === 'completed' ? 'bg-emerald-950/50 text-emerald-400 border border-emerald-900' : 'bg-amber-950/50 text-amber-400 border border-amber-900'}`}>
                            {order.status === 'completed' ? 'Paid' : 'Pending'}
                          </span>
                        </TableCell>
                      </TableRow>
                    ))}
                  </TableBody>
                </Table>
              )}
            </CardContent>
          </Card>
        </div> 
      </div> 
    </main>

    <!-- Modular Overlay Modal Wrapper -->
    <div id="order-modal" class="fixed inset-0 bg-black/60 backdrop-blur-sm hidden items-center justify-center z-50 p-4">
      <Card className="w-full max-w-md p-6 shadow-2xl rounded-3xl border-0">
        <CardHeader className="p-0 mb-4">
          <CardTitle className="text-xl font-black">Checkout New Order</CardTitle>
        </CardHeader>
        
        <form id="order-form" class="space-y-4">
          <!-- Identity References -->
          <input type="hidden" name="clientId" value={clientRecord!.id} />
          <input type="hidden" name="status" value="pending" />

          <div class="space-y-1.5">
            <Label htmlFor="item-select" className="text-xs font-bold uppercase tracking-wider text-muted-foreground">Select Item</Label>
            <select id="item-select" name="itemId" required class="w-full p-3 border rounded-xl bg-transparent text-sm focus:ring-2 focus:ring-indigo-500/20 outline-none transition-all">
              <option value="" data-price="0" class="bg-card">-- Choose from catalog --</option>
              {availableItems.map(item => (
                <option value={item.id} data-price={item.price} class="bg-card">
                  {item.name} (${item.price})
                </option>
              ))}
            </select>
          </div>

          <div class="space-y-1.5">
            <Label htmlFor="item-quantity" className="text-xs font-bold uppercase tracking-wider text-muted-foreground">Quantity</Label>
            <Input id="item-quantity" type="number" name="quantity" defaultValue="1" min="1" required className="rounded-xl focus-visible:ring-indigo-500 h-11 bg-transparent" />
          </div>

          <!-- Total Calculation Feed -->
          <div class="p-4 rounded-2xl flex justify-between items-center border bg-muted/30">
            <span class="text-sm font-bold text-muted-foreground">Order Total:</span>
            <span id="total-price-display" class="text-2xl font-black text-indigo-400">$0</span>
            <input type="hidden" id="amount-input" name="amount" value="0" />
          </div>

          <div class="flex justify-end gap-2 pt-4 border-t mt-6">
            <Button type="button" id="close-order-modal" variant="ghost" className="rounded-xl">Cancel</Button>
            <Button type="submit" className="bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-sm rounded-xl px-6 shadow-lg shadow-indigo-950/50 transition-all">Place Order</Button>
          </div>
        </form>
      </Card>
    </div>
  </div>

  <script> 
    import { authClient } from "@/lib/auth-client"; 

    // Termination Handlers
    document.getElementById('logout-btn')?.addEventListener('click', async () => { 
      await authClient.signOut(); 
      window.location.href = "/login"; 
    }); 

    // Context Nodes & State Accessors
    const modal = document.getElementById('order-modal');
    const openBtn = document.getElementById('open-order-modal');
    const closeBtn = document.getElementById('close-order-modal');
    
    const itemSelect = document.getElementById('item-select') as HTMLSelectElement;
    const quantityInput = document.getElementById('item-quantity') as HTMLInputElement;
    const totalDisplay = document.getElementById('total-price-display');
    const amountInput = document.getElementById('amount-input') as HTMLInputElement;
    const orderForm = document.getElementById('order-form') as HTMLFormElement;

    // Automated Pricing Logic
    function calculateTotal() {
      const selectedOption = itemSelect.options[itemSelect.selectedIndex];
      const price = parseFloat(selectedOption?.getAttribute('data-price') || '0');
      const quantity = parseInt(quantityInput.value || '1', 10);
      
      const total = price * quantity;
      
      if (totalDisplay) totalDisplay.innerText = `$${total}`;
      if (amountInput) amountInput.value = total.toString();
    }

    itemSelect?.addEventListener('change', calculateTotal);
    quantityInput?.addEventListener('input', calculateTotal);

    // Visibility toggles
    openBtn?.addEventListener('click', () => {
      modal?.classList.remove('hidden', 'items-center');
      modal?.classList.add('flex', 'items-center');
    });

    closeBtn?.addEventListener('click', () => {
      modal?.classList.remove('flex', 'items-center');
      modal?.classList.add('hidden');
    });

    // Transaction Forwarding Handlers
    orderForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(orderForm);
      const payload = {
        clientId: Number(formData.get('clientId')),
        itemId: Number(formData.get('itemId')),
        amount: Number(formData.get('amount')),
        status: formData.get('status'),
      };

      if (!payload.itemId) {
        alert("Please select an item!");
        return;
      }

      const res = await fetch('/api/crm/orders', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (res.ok) {
        window.location.reload(); 
      } else {
        alert("Failed to checkout order");
      }
    });
  </script> 
</Layout>