---
export const prerender = false;
import { auth } from "@/lib/auth";
import "@/styles/global.css";

const session = await auth.api.getSession({
  headers: Astro.request.headers,
});

if (!session) {
  return Astro.redirect("/login");
}

const { user } = session;
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <title>Личный кабинет</title>
  </head>
  <body class="bg-slate-50 antialiased">
    <nav class="bg-white border-b sticky top-0 z-10">
      <div class="max-w-5xl mx-auto px-4 h-16 flex items-center justify-between">
        <span class="font-black text-xl tracking-tight">MY DASHBOARD</span>
        
        <div class="flex items-center gap-4">
          <div class="text-right hidden sm:block">
            <p class="text-sm font-bold leading-none">{user.name}</p>
            <p class="text-[10px] text-slate-400">Клиент</p>
          </div>
          <button id="logout-btn" class="bg-rose-50 text-rose-600 p-2 rounded-lg hover:bg-rose-100 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
          </button>
        </div>
      </div>
    </nav>

    <main class="max-w-5xl mx-auto py-10 px-4">
      <header class="mb-10">
        <h1 class="text-4xl font-black text-slate-900 tracking-tight">Добро пожаловать!</h1>
        <p class="text-slate-500 mt-2">Здесь вы можете управлять вашими заказами и профилем.</p>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Карточка профиля -->
        <div class="col-span-1 bg-white p-6 rounded-3xl border border-slate-200 shadow-sm">
          <h3 class="font-bold text-slate-400 uppercase text-[10px] tracking-widest mb-4">Данные профиля</h3>
          <div class="space-y-1">
            <p class="text-slate-900 font-bold">{user.name}</p>
            <p class="text-sm text-slate-500">{user.email}</p>
          </div>
        </div>

        <!-- Заглушка для заказов -->
        <div class="md:col-span-2 bg-indigo-600 p-8 rounded-3xl shadow-xl shadow-indigo-100 text-white">
          <h3 class="text-indigo-200 font-bold uppercase text-[10px] tracking-widest mb-4">Статистика</h3>
          <p class="text-2xl font-black italic opacity-50">У вас пока нет активных заказов</p>
          <button class="mt-6 bg-white text-indigo-600 px-6 py-2 rounded-xl font-bold text-sm hover:bg-indigo-50 transition-colors">
            Заказать услугу
          </button>
        </div>
      </div>
    </main>

    <script>
      import { authClient } from "@/lib/auth-client";
      document.getElementById('logout-btn')?.addEventListener('click', async () => {
        await authClient.signOut();
        window.location.href = "/login";
      });
    </script>
  </body>
</html>